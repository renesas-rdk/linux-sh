CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_HOTPLUG_CPU=y
CONFIG_CPU_IDLE_THERMAL=y
CONFIG_IDLE_INJECT=y

CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

CONFIG_USB_XHCI_PCI_RENESAS=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_DEBUG=y
CONFIG_PCIE_RCAR_GEN4_HOST=m
CONFIG_PCIE_RCAR_GEN4_EP=m
# Integrate firmware into kernel
#CONFIG_EXTRA_FIRMWARE="rcar_gen4_pcie.bin renesas_usb_fw.mem"
#CONFIG_EXTRA_FIRMWARE_DIR="./"

CONFIG_IPMMU_VMSA=y
CONFIG_CMA_SIZE_MBYTES=1024

# For NVME SSD
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_VERBOSE_ERRORS=y
CONFIG_NVME_HWMON=y

# For Raspberry Pi Touch Display v2
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_V2=y
CONFIG_HID_GOODIX_SPI=y
CONFIG_I2C_HID_OF_GOODIX=y
CONFIG_DRM_PANEL_ILITEK_ILI9881C=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# USB camera
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

# For camera modules
CONFIG_VIDEO_IMX290=y
CONFIG_VIDEO_IMX708=y

# Disable Sleep/Suspend
CONFIG_PM_SLEEP=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n

# Argon FAN HAT
CONFIG_PWM_ARGON_FAN_HAT=y

# Enable IPv6
CONFIG_IPV6=y

# For USB Multitouch Display
CONFIG_HID_MULTITOUCH=y

# Fix ACL operation not supported
CONFIG_POSIX_ACL=y
CONFIG_TMPFS_POSIX_ACL=y

# For Bluetooth/Virtual device
CONFIG_UHID=y

# Add UID driver
CONFIG_UIO=m
CONFIG_UIO_PDRV_GENIRQ=m
CONFIG_UIO_DMEM_GENIRQ=m

# Kernel version
CONFIG_LOCALVERSION_AUTO=n
CONFIG_LOCALVERSION="-arm64-renesas"

# CONFIG_RT_GROUP_SCHED is not set

# Enable firmware loading support
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Intel RealSense Camera support
CONFIG_IIO_TRIGGERED_BUFFER=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_IIO_TRIGGER=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_USB_GSPCA=m
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m

# Docker support
# Generally Necessary
CONFIG_MULTIUSER=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_SMP=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_KEYS=y
CONFIG_NET_CORE=y
CONFIG_VETH=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_VS=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_NEEDED=y
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m

# Optional Features
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_CGROUP_PIDS=y
CONFIG_ARCH_NO_SWAP=n
CONFIG_BLOCK=y
CONFIG_MMU=y
CONFIG_SWAP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_HAVE_PERF_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_CGROUP_PERF=y
CONFIG_HUGETLB_PAGE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_EXT3_FS=y
CONFIG_EXT3_FS_POSIX_ACL=y
CONFIG_EXT3_FS_SECURITY=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
#  Network Drivers
#   "overlay":
CONFIG_VXLAN=y
#    Optional (for encrypted networks):
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_GHASH=y
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y
CONFIG_INET_ESP=y
CONFIG_INET_XFRM_MODE_TRANSPORT=y
#   "ipvlan":
CONFIG_IPVLAN=y
CONFIG_MACVLAN=y
#   "macvlan":
CONFIG_DUMMY=y
#   "ftp,tftp client in container":
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_TFTP=y
#   "devicemapper":
CONFIG_DAX=y
CONFIG_DM_THIN_PROVISIONING=y
#   "overlay":
CONFIG_OVERLAY_FS=y

# Adds the "MARK" target.
# The target allows you to create rules in the "mangle" table which
# alter the netfilter mark (nfmark) field associated with the packet.
CONFIG_NETFILTER_XT_MARK=y
# FUSE support
CONFIG_FUSE_FS=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
# firmware EDID
CONFIG_FIRMWARE_EDID=y
# USB CAN
CONFIG_CAN_PEAK_USB=m
CONFIG_CAN_GS_USB=m
CONFIG_CAN_8DEV_USB=m
CONFIG_CAN_EMS_USB=m
CONFIG_CAN_ESD_USB=m
CONFIG_CAN_ETAS_ES58X=m
CONFIG_CAN_F81604=m
CONFIG_CAN_KVASER_USB=m
CONFIG_CAN_MCBA_USB=m
CONFIG_CAN_UCAN=m
# USB Serial
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_WWAN=m
# Wifi
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_CRYPTO_ECDH=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMUTIL=m
# Bluetooth
CONFIG_BT=m
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HCIUART=n
CONFIG_BT_HCIUART_BCM=n
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_MTK=m
CONFIG_BT_RTL=m

CONFIG_IP_NF_SECURITY=m
CONFIG_EXT3_FS_SECURITY=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_NFS_V4_SECURITY_LABEL=y
CONFIG_SECURITY=y
CONFIG_DEFAULT_SECURITY_DAC=y